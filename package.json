{
	"name": "@werkbank/ui",
	"version": "0.1.0",
	"license": "SEE LICENSE IN LICENSE",
	"author": "Schubert Solutions UG (haftungsbeschränkt)",
	"keywords": [
		"svelte"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./base.css": "./dist/styles/base.css",
		"./themes/neutral.css": "./dist/styles/themes/neutral.css",
		"./themes/arcade.css": "./dist/styles/themes/arcade.css"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package && publint",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && svelte-package || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest --run",
		"build:showcase": "vite build"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0"
	},
	"description": "Svelte-5-Komponenten mit Design-Tokens und austauschbaren Themes (neutral, arcade).",
	"private": true,
	"packageManager": "pnpm@12.21.0"
}
